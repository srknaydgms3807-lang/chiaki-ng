<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory
        app:key="category_general"
        app:title="@string/preferences_category_title_general">
        <Preference
            app:key="registered_hosts"
            tools:summary="@string/preferences_registered_hosts_summary"
            app:summary=" "
            app:title="@string/preferences_registered_hosts_title"
            app:fragment="com.metallic.chiaki.settings.SettingsRegisteredHostsFragment"
            app:icon="@drawable/ic_console_simple"/>

        <SwitchPreference
            app:key="@string/preferences_swap_cross_moon_key"
            app:title="@string/preferences_swap_cross_moon_title"
            app:summary="@string/preferences_swap_cross_moon_summary"
            app:icon="@drawable/ic_gamepad" />

        <SwitchPreference
            app:key="@string/preferences_rumble_enabled_key"
            app:title="@string/preferences_rumble_enabled_title"
            app:summary="@string/preferences_rumble_enabled_summary"
            app:icon="@drawable/ic_rumble" />

        <SwitchPreference
            app:key="@string/preferences_motion_enabled_key"
            app:title="@string/preferences_motion_enabled_title"
            app:summary="@string/preferences_motion_enabled_summary"
            app:icon="@drawable/ic_motion" />

        <SwitchPreference
            app:key="@string/preferences_button_haptic_enabled_key"
            app:title="@string/preferences_button_haptic_enabled_title"
            app:summary="@string/preferences_button_haptic_enabled_summary"
            app:icon="@drawable/ic_button_haptic" />

        <SwitchPreference
            app:key="@string/preferences_log_verbose_key"
            app:title="@string/preferences_log_verbose_title"
            app:summary="@string/preferences_log_verbose_summary"
            app:icon="@drawable/ic_log" />

        <Preference
            app:key="logs"
            app:summary="@string/preferences_logs_summary"
            app:title="@string/preferences_logs_title"
            app:fragment="com.metallic.chiaki.settings.SettingsLogsFragment"
            app:icon="@drawable/ic_log"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:key="category_stream"
        app:title="@string/preferences_category_title_stream">
        <ListPreference
            app:key="@string/preferences_resolution_key"
            app:title="@string/preferences_resolution_title"
            app:summary="%s"
            app:icon="@drawable/ic_resolution"/>

        <ListPreference
            app:key="@string/preferences_fps_key"
            app:title="@string/preferences_fps_title"
            app:summary="%s"
            app:icon="@drawable/ic_fps"/>

        <EditTextPreference
            app:key="@string/preferences_bitrate_key"
            app:title="@string/preferences_bitrate_title"
            app:icon="@drawable/ic_bitrate"/>

        <ListPreference
            app:key="@string/preferences_codec_key"
            app:title="@string/preferences_codec_title"
            app:summary="%s"
            app:icon="@drawable/ic_codec"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:key="category_export"
        app:title="@string/preferences_category_title_export">
        <Preference
            app:key="@string/preferences_export_settings_key"
            app:summary="@string/preferences_export_settings_summary"
            app:title="@string/preferences_export_settings_title"
            app:icon="@drawable/ic_export"/>

        <Preference
            app:key="@string/preferences_import_settings_key"
            app:summary="@string/preferences_import_settings_summary"
            app:title="@string/preferences_import_settings_title"
            app:icon="@drawable/ic_import"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:key="category_tr_subtitles"
        app:title="Türkçe altyazı">
        <SwitchPreference
            app:key="tr_subtitles_enabled"
            android:defaultValue="true"
            app:title="Türkçe altyazıyı aç"
            app:summary="Oyundaki İngilizce altyazıyı telefonda okuyup internetsiz olarak Türkçeye çevirir" />

        <SeekBarPreference
            app:key="tr_region_top"
            android:defaultValue="66"
            app:min="0"
            android:max="99"
            app:showSeekBarValue="true"
            app:title="Altyazı alanı: üst kenar (%)"
            app:summary="Ekranın üstünden yüzde kaç aşağıda başlasın. RDR2 için 66" />

        <SeekBarPreference
            app:key="tr_region_bottom"
            android:defaultValue="86"
            app:min="1"
            android:max="100"
            app:showSeekBarValue="true"
            app:title="Altyazı alanı: alt kenar (%)"
            app:summary="Kontrol ipuçlarına (Hold X…) gelmeden bitsin. RDR2 için 86" />

        <SeekBarPreference
            app:key="tr_region_side"
            android:defaultValue="15"
            app:min="0"
            android:max="45"
            app:showSeekBarValue="true"
            app:title="Altyazı alanı: yanlardan pay (%)"
            app:summary="Haritayı dışarıda bırakmak için soldan ve sağdan kırpılır" />

        <SeekBarPreference
            app:key="tr_text_size"
            android:defaultValue="22"
            app:min="12"
            android:max="48"
            app:showSeekBarValue="true"
            app:title="Türkçe yazı boyutu" />

        <SeekBarPreference
            app:key="tr_brightness"
            android:defaultValue="185"
            app:min="100"
            android:max="250"
            app:showSeekBarValue="true"
            app:title="Yazı algılama eşiği"
            app:summary="Altyazı geç algılanıyorsa düşürün, karlı sahnelerde yavaşlıyorsa artırın" />

        <SwitchPreference
            app:key="tr_voice_enabled"
            android:defaultValue="true"
            app:title="Türkçe sesli okuma (dublaj)"
            app:summary="Çeviriyi telefonun Türkçe sesiyle okur; yeni altyazı gelince öncekini keser" />

        <SeekBarPreference
            app:key="tr_voice_rate"
            android:defaultValue="115"
            app:min="50"
            android:max="200"
            app:showSeekBarValue="true"
            app:title="Okuma hızı (%)"
            app:summary="Konuşmaya yetişemiyorsa artırın. 100 = normal" />

        <ListPreference
            app:key="tr_voice_engine"
            android:defaultValue="elevenlabs"
            app:entries="@array/tr_voice_engine_titles"
            app:entryValues="@array/tr_voice_engine_values"
            app:useSimpleSummaryProvider="true"
            app:title="Ses motoru" />

        <EditTextPreference
            app:key="tr_eleven_key"
            app:title="ElevenLabs API anahtarı"
            app:summary="elevenlabs.io > Profil > API Keys. Sadece bu telefonda saklanır, kimseyle paylaşmayın" />

        <EditTextPreference
            app:key="tr_eleven_voice"
            app:title="ElevenLabs ses kimliği (Voice ID)"
            app:summary="Boş bırakılırsa kalın sesli Amerikalı erkek anlatıcı. Başka ses için ElevenLabs'te sesin kimliğini kopyalayıp yapıştırın" />

        <ListPreference
            app:key="tr_eleven_model"
            android:defaultValue="eleven_flash_v2_5"
            app:entries="@array/tr_eleven_model_titles"
            app:entryValues="@array/tr_eleven_model_values"
            app:useSimpleSummaryProvider="true"
            app:title="ElevenLabs modeli" />

        <SeekBarPreference
            app:key="tr_eleven_stability"
            android:defaultValue="35"
            app:min="0"
            android:max="100"
            app:showSeekBarValue="true"
            app:title="Ses dengesi (%)"
            app:summary="Düşük = daha duygulu ve değişken, yüksek = daha düz ve tutarlı" />

        <SeekBarPreference
            app:key="tr_eleven_style"
            android:defaultValue="45"
            app:min="0"
            android:max="100"
            app:showSeekBarValue="true"
            app:title="Vurgu gücü (%)"
            app:summary="Sadece Duygulu modelde: yüksek = daha abartılı, oyunculu konuşma" />

        <SeekBarPreference
            app:key="tr_voice_index"
            android:defaultValue="1"
            app:min="1"
            android:max="10"
            app:showSeekBarValue="true"
            app:title="Ses numarası"
            app:summary="Telefondaki Türkçe sesler arasında gezinir. Hangisinin seçili olduğu oyun ekranındaki teşhis satırında yazar" />

        <SeekBarPreference
            app:key="tr_voice_pitch"
            android:defaultValue="80"
            app:min="50"
            android:max="150"
            app:showSeekBarValue="true"
            app:title="Ses kalınlığı (%)"
            app:summary="Düşük = daha kalın, sert erkek sesi. 100 = normal" />

        <SwitchPreference
            app:key="tr_debug"
            android:defaultValue="true"
            app:title="Teşhis satırını göster"
            app:summary="Oyun ekranının sol üstünde çeviri durumunu gösterir (sorun giderme için)" />
    </PreferenceCategory>
</PreferenceScreen>